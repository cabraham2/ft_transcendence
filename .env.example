# ft_transcendence - copy to .env (cp .env.example .env) and fill in every value.
# .env is ignored by Git. Never commit real secrets.

# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>?schema=public
DATABASE_URL=

# Authentication (generate with: openssl rand -hex 32)
JWT_SECRET=
# Token lifetime in seconds (e.g. 86400 = 24h)
JWT_EXPIRES_IN_SECONDS=

# Public API (API key: openssl rand -hex 20)
PUBLIC_API_KEY=
# Max requests per window and window size in ms (e.g. 60 and 60000)
PUBLIC_API_RATE_LIMIT=
PUBLIC_API_RATE_WINDOW_MS=

# Grace period in ms before a disconnected player forfeits (e.g. 30000)
MATCH_DISCONNECT_GRACE_MS=
